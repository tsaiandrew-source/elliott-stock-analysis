{
  "schemaVersion": "elliott-news-sources-v1",
  "lastReviewed": "2026-09-23",
  "purpose": "Canonical discovery list for the cross-market digest. Add or disable sources here; individual digest citations remain in digests.json.",
  "usageRules": [
    "Use primary sources for claims whenever an official release, filing, speech, essay, or company announcement exists.",
    "Use independent reporting to establish market reaction, context, and competing interpretations.",
    "Do not use social posts, forums, or unattributed aggregators as sole evidence for a material claim.",
    "A source in this registry is eligible for discovery, not automatic proof; every cited page must still pass freshness and claim-level verification.",
    "Scan enabled executive and company primary sources over weekends so essays or announcements that may move Monday markets are not missed."
  ],
